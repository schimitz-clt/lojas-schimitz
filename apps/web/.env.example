# SSR / server fetches (storefront, sitemap) — absolute Railway or local API.
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Same-origin proxy target (web Route Handler /api/v1/* → Nest).
# Origin only (sem /api/v1). Em produção Railway web:
#   API_PROXY_TARGET=https://lojas-schimitz-production.up.railway.app
# Se omitido, deriva do host de NEXT_PUBLIC_API_URL (sem duplicar /api/v1).
# API_PROXY_TARGET=http://localhost:3001

# WhatsApp da loja (DDI 55 + DDD + número). Vitrine + botões do admin.
# Clique-para-conversar (wa.me). Sem Cloud API / Twilio.
# Troque só se o número da loja mudar. Padrão: Lojas Schimitz.
NEXT_PUBLIC_WHATSAPP=5551996253766

# Chat usa NEXT_PUBLIC_API_URL (POST /chat) e NEXT_PUBLIC_WHATSAPP (handoff).
# Sem chave LLM no serviço da API o widget ainda funciona (FAQ + WhatsApp).

# SEO / sitemap
# NEXT_PUBLIC_SITE_URL=https://sua-loja.com

# Mercado Pago Checkout Bricks (cartão na página do pedido)
# Deve casar com MERCADO_PAGO_PUBLIC_KEY / PAYMENTS_PROVIDER=mercadopago na API.
# NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY=TEST-xxxx
# Dev-only (nunca em produção):
# NEXT_PUBLIC_ALLOW_PAYMENT_SIMULATE=true
# NEXT_PUBLIC_NULL_WEBHOOK_SECRET=dev-secret-min-16
