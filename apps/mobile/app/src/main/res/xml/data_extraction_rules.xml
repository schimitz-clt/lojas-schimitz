<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+: nada do app vai para backup na nuvem nem é copiado na transferência entre aparelhos.
  O WebView guarda os cookies de sessão (login, refresh token, carrinho) em app_webview/ e
  shared_prefs; restaurar isso em outro aparelho levaria a sessão junto. allowBackup="false"
  sozinho não cobre a transferência entre aparelhos no Android 12+.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
