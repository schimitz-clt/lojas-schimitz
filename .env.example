# Copie para .env — nunca commite o .env
APP_ENV=development
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1

# OpenAPI/Swagger UI em /api/v1/docs — default ON fora de prod/staging; OFF em production
# SWAGGER_ENABLED=true
# SWAGGER_ENABLED=false

# Banco
DATABASE_URL=postgresql://schimitz:schimitz@localhost:5432/lojas_schimitz?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT — gere valores longos e aleatórios (ex: openssl rand -base64 48)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
# Access TTL is env-driven; keep 15m unless you explicitly shorten in Railway.
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# Refresh em cookie HttpOnly (SCH-006) — dual com body refreshToken
# REFRESH_COOKIE_ENABLED=true
# REFRESH_COOKIE_NAME=sch_refresh
# REFRESH_COOKIE_SECURE=true
# REFRESH_COOKIE_SAMESITE=none
# REFRESH_COOKIE_DOMAIN=.lojasschimitz.com.br
# REFRESH_COOKIE_MAX_AGE_SEC=2592000
# JSON refreshToken: default true (unset = compat). Cookie-only JSON em prod:
#   Railway → serviço API → REFRESH_JSON_TOKEN_ENABLED=false
#   (depois do merge; rollback = true ou unset). Não setar no serviço web.
# REFRESH_JSON_TOKEN_ENABLED=true

# CORS — origens permitidas, separadas por vírgula
CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# Admin seed / bootstrap: se o usuário existir, a API promove a role=admin status=active no boot
ADMIN_EMAIL=admin@lojas-schimitz.test
ADMIN_PASSWORD=change-me-admin-password
# Opcional: e-mails extras para "Nova venda paga" (CSV). Sempre incluídos além dos admins no DB.
# STORE_NOTIFY_EMAIL=schimitzclaiton@gmail.com

# Site (SEO)
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Pagamentos SCH-003 — null (padrão/testes) | mercadopago
PAYMENTS_PROVIDER=null
# MERCADO_PAGO_ACCESS_TOKEN=TEST-xxxx
# MERCADO_PAGO_WEBHOOK_SECRET=whsec_xxxx
# MERCADO_PAGO_PUBLIC_KEY=TEST-xxxx
# Public key do Brick de cartão — OBRIGATÓRIA no serviço WEB (Railway/Next), não só na API:
# NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY=TEST-xxxx
# PUBLIC_API_URL=https://sua-api.up.railway.app
#
# DEV ONLY — NUNCA setar no Railway production (serviço web OU API).
# `next build` (NODE_ENV=production) APAGA NEXT_PUBLIC_ALLOW_PAYMENT_SIMULATE e
# NEXT_PUBLIC_NULL_WEBHOOK_SECRET antes do bundle (não vazam no JS).
# A API trata Railway production / NODE_ENV=production como prod-like:
# allowNullPaymentSimulate() = false; provider null bloqueado sem override.
# ALLOW_NULL_PAYMENT_SIMULATE=true
# NULL_WEBHOOK_SECRET=
# NEXT_PUBLIC_ALLOW_PAYMENT_SIMULATE=true
# NEXT_PUBLIC_NULL_WEBHOOK_SECRET=
# ALLOW_NULL_PROVIDER_IN_PROD=true

# Frete / transportadora (MEGA Phase 14)
# FREIGHT (cotação checkout) = ShippingProvider / regras CEP — independente do adapter de etiqueta.
# CARRIER_PROVIDER=propria (padrão) | melhor_envio
# propria = etiqueta/rastreio MANUAL via PATCH /admin/orders/:id/status { trackingCode, carrier }
# melhor_envio = stub: sem token → NOT_CONFIGURED; com token → CARRIER_LIVE_NOT_WIRED (sem HTTP live ainda)
# CARRIER_PROVIDER=propria
# MELHOR_ENVIO_TOKEN=
# MELHOR_ENVIO_ACCESS_TOKEN=
# (nunca commitar tokens; só Railway / .env local)

# WhatsApp da loja (DDI 55 + DDD + número, só dígitos).
# Usado na vitrine e nos botões do admin (wa.me clique-para-conversar).
# NÃO é token da Cloud API / Twilio — envio automático NÃO está implementado.
# NEXT_PUBLIC_WHATSAPP=5551996253766
# WHATSAPP_PHONE=5551996253766
#
# Envio automático no futuro: WhatsApp Cloud API (Meta) + templates aprovados.
# Não inventar/commitar tokens da Meta ou Twilio.

# Uploads de imagens (admin) — pasta local / volume Railway
# Em Railway: monte um Volume em /data/uploads e use UPLOADS_DIR=/data/uploads
UPLOADS_DIR=./uploads
# Origem pública (apex) — preferida para gravar URL de foto nova (sem www)
# SITE_URL=https://lojasschimitz.com.br
# APP_URL=https://lojasschimitz.com.br
# URL pública da API (sem barra final) — fallback se SITE_URL/APP_URL ausentes
# PUBLIC_API_URL=https://sua-api.up.railway.app/api/v1

# E-mail transacional (cliente)
# Preferência no Railway: Resend HTTP (egress SMTP costuma ser bloqueado → ETIMEDOUT)
# RESEND_API_KEY=re_xxxx
# MAIL_FROM="Lojas Schimitz <onboarding@resend.dev>"   # ou domínio verificado
# Dual-use: se SMTP_PASS começa com re_ e SMTP_HOST contém resend, a API usa HTTPS
# (mesmo sem RESEND_API_KEY). SMTP_HOST/SMTP_PASS continuam ok para provedores SMTP.
# Sem RESEND_API_KEY/SMTP_HOST+MAIL_FROM a API só registra log e não envia (não quebra pagamentos)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=seu-email@gmail.com
# SMTP_PASS=app-password-ou-senha-smtp
# MAIL_FROM="Lojas Schimitz <loja@seudominio.com>"
# Avisos de venda paga para a LOJA: STORE_NOTIFY_EMAIL (CSV) e/ou ADMIN_EMAIL + admins ativos no DB.
# MAIL_FROM é só remetente (noreply ok) — NÃO entra na lista de destinatários da loja.
# STORE_NOTIFY_EMAIL=schimitzclaiton@gmail.com

# Schimitz AI (Alfa) — OpenAI-compatible. Sem chave = FAQ + tools + WhatsApp (sem cobrança).
# Nunca commitar a chave. No Railway: variáveis do serviço da API.
# SCHIMITZ_AI_ENABLED=true
# CHAT_AI_MODE=alfa
# OPENAI_API_KEY=
# CHAT_API_KEY=
# CHAT_API_BASE=https://api.openai.com/v1
# CHAT_MODEL=gpt-4o-mini

# Password reset — usa SMTP acima + URL do site no e-mail
# NEXT_PUBLIC_SITE_URL=https://lojasschimitz.com.br
# (sem SMTP_HOST/MAIL_FROM o token é persistido e o link só aparece no log da API em local)

# Cupons que duplicam a promo automática PIX 5% (além de PIX5). CSV opcional.
# PIX_PROMO_COLLIDING_COUPON_CODES=PIX5

# Marketplace v2 — split automático Mercado Pago.
# Fase 2 (sandbox, SEM dinheiro live):
#   MP_MARKETPLACE_SPLIT_ENABLED=true  → OAuth + (se ALLOW_LIVE=false e
#     credenciais de teste: TEST- ou APP_USR de "Credenciais de teste" no
#     painel MP, em staging / non-prod) createIntent usa token do vendedor
#     + application_fee.
#   MP_MARKETPLACE_SPLIT_ALLOW_LIVE    → DEIXE false. true NÃO liga split em
#     produção (Fase 2 fail-closed). NÃO documentamos ligar isso em production.
# Produção com APP_USR live: caminho atual (collector da loja), mesmo com ENABLED.
# Staging: credenciais de teste MP (TEST- ou APP_USR de test_user). Nunca seed fake em prod.
# Plano: docs/MARKETPLACE-MP-SPLIT-PLAN.md
# MP_MARKETPLACE_SPLIT_ENABLED=false
# MP_MARKETPLACE_SPLIT_ALLOW_LIVE=false
# App MP tipo Marketplace (Railway, só API — nunca NEXT_PUBLIC_*):
# MP_MARKETPLACE_CLIENT_ID=
# MP_MARKETPLACE_CLIENT_SECRET=
# Redirect deve bater com o app MP (web /vendedor/mp/callback):
# MP_MARKETPLACE_REDIRECT_URI=https://lojasschimitz.com.br/vendedor/mp/callback
# AES-256-GCM (32 bytes hex 64 chars ou base64) — obrigatória para guardar tokens OAuth:
# MP_SELLER_CREDENTIAL_KEY=
# Opcional: HMAC do state OAuth (senão usa JWT_ACCESS_SECRET)
# MP_OAUTH_STATE_SECRET=
