# Copie para .env — nunca commite o .env
APP_ENV=development
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1

# OpenAPI/Swagger UI em /api/v1/docs — default ON fora de prod/staging; OFF em production
# SWAGGER_ENABLED=true
# SWAGGER_ENABLED=false

# Banco
DATABASE_URL=postgresql://schimitz:schimitz@localhost:5432/lojas_schimitz?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT — gere valores longos e aleatórios (ex: openssl rand -base64 48)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# Refresh em cookie HttpOnly (SCH-006) — dual com body refreshToken
# REFRESH_COOKIE_ENABLED=true
# REFRESH_COOKIE_NAME=sch_refresh
# REFRESH_COOKIE_SECURE=true
# REFRESH_COOKIE_SAMESITE=none
# REFRESH_COOKIE_DOMAIN=.lojasschimitz.com.br
# REFRESH_COOKIE_MAX_AGE_SEC=2592000
# Phase 9: keep true until Set-Cookie-only login proven for web+Android WebView
# REFRESH_JSON_TOKEN_ENABLED=true

# CORS — origens permitidas, separadas por vírgula
CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# Admin seed / bootstrap: se o usuário existir, a API promove a role=admin status=active no boot
ADMIN_EMAIL=admin@lojas-schimitz.test
ADMIN_PASSWORD=change-me-admin-password
# Opcional: e-mails extras para "Nova venda paga" (CSV). Sempre incluídos além dos admins no DB.
# STORE_NOTIFY_EMAIL=schimitzclaiton@gmail.com

# Site (SEO)
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Pagamentos SCH-003 — null (padrão/testes) | mercadopago
PAYMENTS_PROVIDER=null
# MERCADO_PAGO_ACCESS_TOKEN=TEST-xxxx
# MERCADO_PAGO_WEBHOOK_SECRET=whsec_xxxx
# MERCADO_PAGO_PUBLIC_KEY=TEST-xxxx
# NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY=TEST-xxxx
# PUBLIC_API_URL=https://sua-api.up.railway.app
# ALLOW_NULL_PAYMENT_SIMULATE=true
# NULL_WEBHOOK_SECRET=
# NEXT_PUBLIC_ALLOW_PAYMENT_SIMULATE=true
# NEXT_PUBLIC_NULL_WEBHOOK_SECRET=
# ALLOW_NULL_PROVIDER_IN_PROD=true

# Integrações futuras
# MELHOR_ENVIO_TOKEN=

# WhatsApp da loja (DDI 55 + DDD + número, só dígitos).
# Usado na vitrine e nos botões do admin (wa.me clique-para-conversar).
# NÃO é token da Cloud API / Twilio — envio automático NÃO está implementado.
# NEXT_PUBLIC_WHATSAPP=5551996253766
# WHATSAPP_PHONE=5551996253766
#
# Envio automático no futuro: WhatsApp Cloud API (Meta) + templates aprovados.
# Não inventar/commitar tokens da Meta ou Twilio.

# Uploads de imagens (admin) — pasta local / volume Railway
# Em Railway: monte um Volume em /data/uploads e use UPLOADS_DIR=/data/uploads
UPLOADS_DIR=./uploads
# Origem pública (apex) — preferida para gravar URL de foto nova (sem www)
# SITE_URL=https://lojasschimitz.com.br
# APP_URL=https://lojasschimitz.com.br
# URL pública da API (sem barra final) — fallback se SITE_URL/APP_URL ausentes
# PUBLIC_API_URL=https://sua-api.up.railway.app/api/v1

# E-mail transacional (cliente)
# Preferência no Railway: Resend HTTP (egress SMTP costuma ser bloqueado → ETIMEDOUT)
# RESEND_API_KEY=re_xxxx
# MAIL_FROM="Lojas Schimitz <onboarding@resend.dev>"   # ou domínio verificado
# Dual-use: se SMTP_PASS começa com re_ e SMTP_HOST contém resend, a API usa HTTPS
# (mesmo sem RESEND_API_KEY). SMTP_HOST/SMTP_PASS continuam ok para provedores SMTP.
# Sem RESEND_API_KEY/SMTP_HOST+MAIL_FROM a API só registra log e não envia (não quebra pagamentos)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=seu-email@gmail.com
# SMTP_PASS=app-password-ou-senha-smtp
# MAIL_FROM="Lojas Schimitz <loja@seudominio.com>"
# (o endereço de MAIL_FROM também recebe avisos de venda paga, se não for *.test)

# Chat IA (Phase 1) — OpenAI-compatible. Sem chave = FAQ + catálogo + link WhatsApp.
# Nunca commitar a chave. No Railway: variáveis do serviço da API.
# OPENAI_API_KEY=
# CHAT_API_KEY=
# CHAT_API_BASE=https://api.openai.com/v1
# CHAT_MODEL=gpt-4o-mini

# Password reset — usa SMTP acima + URL do site no e-mail
# NEXT_PUBLIC_SITE_URL=https://lojasschimitz.com.br
# (sem SMTP_HOST/MAIL_FROM o token é persistido e o link só aparece no log da API em local)
