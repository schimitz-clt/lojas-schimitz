# Copie para .env — nunca commite o .env
APP_ENV=development
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1

# Banco
DATABASE_URL=postgresql://schimitz:schimitz@localhost:5432/lojas_schimitz?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT — gere valores longos e aleatórios (ex: openssl rand -base64 48)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# CORS — origens permitidas, separadas por vírgula
CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# Admin seed (apenas development)
ADMIN_EMAIL=admin@lojas-schimitz.test
ADMIN_PASSWORD=change-me-admin-password

# Site (SEO)
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Pagamentos SCH-003 — null (padrão/testes) | mercadopago
PAYMENTS_PROVIDER=null
# MERCADO_PAGO_ACCESS_TOKEN=TEST-xxxx
# MERCADO_PAGO_WEBHOOK_SECRET=whsec_xxxx
# MERCADO_PAGO_PUBLIC_KEY=TEST-xxxx
# NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY=TEST-xxxx

# Integrações futuras
# MELHOR_ENVIO_TOKEN=
