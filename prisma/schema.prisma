generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  customer
  admin
  seller
}

enum UserStatus {
  active
  blocked
}

enum SellerStatus {
  pending
  active
  suspended
}

/** Mercado Pago OAuth link for marketplace v2 Phase 1 (no live split). */
enum SellerMpOAuthStatus {
  pending
  linked
  expired
  revoked
}

enum ProductCondition {
  new
  used
  refurbished
}

enum OrderStatus {
  draft
  awaiting_payment
  paid
  /** Legado — migrado para organizing; mantido no enum. */
  separating
  organizing
  packing
  ready_for_pickup
  /** Legado — migrado para in_transit; mantido no enum. */
  shipped
  in_transit
  delivered
  cancelled
  refunded
}

enum PaymentStatus {
  pending
  approved
  refused
  expired
  cancelled
  refunded
}

enum PaymentMethod {
  pix
  card
  boleto
  wallet
}

model User {
  id              String     @id @default(uuid())
  email           String     @unique
  passwordHash    String
  name            String
  phone           String?
  role            UserRole   @default(customer)
  status          UserStatus @default(active)
  /** SCHIMITZ+ saldo em BRL (cashback). */
  cashbackBalance Decimal    @default(0) @db.Decimal(12, 2)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  addresses       Address[]
  carts           Cart[]
  orders          Order[]
  reviews         Review[]
  favorites       Favorite[]
  refreshTokens        RefreshToken[]
  passwordResetTokens  PasswordResetToken[]
  cashbackLedger       CashbackLedger[]
  notifications        Notification[]
  sellersOwned         Seller[]
  deviceFcmTokens      DeviceFcmToken[]
  pushCampaignsCreated PushCampaign[]
  productViewEvents    ProductViewEvent[]
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  jti       String?   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/** One-time password reset; store SHA-256(hex) of raw token only — never the raw token. */
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  requestIp String?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Address {
  id         String  @id @default(uuid())
  userId     String
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String  @default("Casa")
  cep        String
  street     String
  number     String
  complement String?
  district   String
  city       String
  uf         String
  ibge       String?
  isDefault  Boolean @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}


model Seller {
  id                String       @id @default(uuid())
  name              String
  slug              String       @unique
  status            SellerStatus @default(pending)
  ownerUserId       String?
  owner             User?        @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  /** Used for ledger + sandbox application_fee (Phase 2). */
  commissionPercent Decimal?     @db.Decimal(5, 2)
  /** MP collector_id after OAuth. */
  mpUserId          String?      @unique
  mpPublicKey       String?
  mpOAuthStatus     SellerMpOAuthStatus @default(pending)
  mpTokenExpiresAt  DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  products     Product[]
  orderItems   OrderItem[]
  commissions  CommissionLedger[]
  mpCredential SellerMpCredential?

  @@index([status])
  @@index([ownerUserId])
  @@index([mpOAuthStatus])
}

/**
 * Encrypted Mercado Pago seller tokens (AES-256-GCM envelope).
 * Never returned on APIs. Phase 2 createIntent may decrypt only on the sandbox path.
 */
model SellerMpCredential {
  id              String   @id @default(uuid())
  sellerId        String   @unique
  seller          Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  accessTokenEnc  String
  refreshTokenEnc String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Category {
  id        String     @id @default(uuid())
  slug      String     @unique
  name      String
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  sort      Int        @default(0)
  active    Boolean    @default(true)
  products  Product[]
}

model Product {
  id             String            @id @default(uuid())
  sku            String            @unique
  name           String
  slug           String            @unique
  description    String            @default("")
  sellerId       String
  seller         Seller            @relation(fields: [sellerId], references: [id])
  categoryId     String?
  category       Category?         @relation(fields: [categoryId], references: [id])
  price          Decimal           @db.Decimal(12, 2)
  compareAtPrice Decimal?          @db.Decimal(12, 2)
  condition      ProductCondition  @default(new)
  ratingAvg      Decimal           @default(0) @db.Decimal(3, 2)
  ratingCount    Int               @default(0)
  badge          String?
  active         Boolean           @default(true)
  widthCm        Decimal?          @db.Decimal(8, 2)
  heightCm       Decimal?          @db.Decimal(8, 2)
  lengthCm       Decimal?          @db.Decimal(8, 2)
  weightKg       Decimal?          @db.Decimal(8, 3)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  images              ProductImage[]
  inventory           Inventory?
  cartItems           CartItem[]
  orderItems          OrderItem[]
  reviews             Review[]
  favorites           Favorite[]
  productViews        ProductViewEvent[]
  abandonedViewPushes AbandonedViewPush[]

  @@index([sellerId])
  @@index([active])
  @@index([categoryId])
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String  @default("")
  position  Int     @default(0)

  @@index([productId])
}

model Inventory {
  id          String  @id @default(uuid())
  productId   String  @unique
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  qtyOnHand   Int     @default(0)
  qtyReserved Int     @default(0)
  warehouse   String  @default("origin-91250")
  updatedAt   DateTime @updatedAt
}

model Cart {
  id         String     @id @default(uuid())
  userId     String?
  user       User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  guestToken String?
  /** Código persistido na sacola; revalidado a cada GET / apply. */
  couponCode String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  items      CartItem[]

  @@index([userId])
  @@index([guestToken])
}

model CartItem {
  id        String  @id @default(uuid())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  qty       Int     @default(1)

  @@unique([cartId, productId])
}

model Coupon {
  id            String    @id @default(uuid())
  code          String    @unique
  type          String
  value         Decimal   @db.Decimal(12, 2)
  minSubtotal   Decimal?  @db.Decimal(12, 2)
  startsAt      DateTime?
  endsAt        DateTime?
  maxUses       Int?
  usedCount     Int       @default(0)
  reservedCount Int       @default(0)
  active        Boolean   @default(true)
  orders        Order[]
}

model Order {
  id                   String      @id @default(uuid())
  publicId             String      @unique
  userId               String?
  user                 User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  status               OrderStatus @default(draft)
  subtotal             Decimal     @db.Decimal(12, 2)
  discount             Decimal     @default(0) @db.Decimal(12, 2)
  /** Valor de SCHIMITZ+ (cashback) aplicado neste pedido. */
  cashbackUsed         Decimal     @default(0) @db.Decimal(12, 2)
  freight              Decimal     @default(0) @db.Decimal(12, 2)
  total                Decimal     @db.Decimal(12, 2)
  couponId             String?
  coupon               Coupon?     @relation(fields: [couponId], references: [id])
  addressSnap          Json?
  freightSnap          Json?
  carrier              String?
  trackingCode         String?
  reservationExpiresAt DateTime?
  idempotencyKey       String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  items           OrderItem[]
  payments        Payment[]
  cashbackLedger  CashbackLedger[]
  commissions     CommissionLedger[]
  statusHistory   OrderStatusHistory[]
  notifications   Notification[]

  @@unique([userId, idempotencyKey])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([userId, status])
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  /** Snapshot do vendedor no momento do pedido (marketplace v1). */
  sellerId  String?
  seller    Seller? @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  name      String
  /** Snapshot da foto de capa no momento do pedido (histórico sem snapshot usa ProductImage atual). */
  imageUrl  String?
  qty       Int
  unitPrice Decimal @db.Decimal(12, 2)

  commissions CommissionLedger[]

  @@index([orderId])
  @@index([productId])
  @@index([sellerId])
}

model Payment {
  id                String           @id @default(uuid())
  orderId           String
  order             Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider          String           @default("mercadopago")
  method            PaymentMethod
  status            PaymentStatus    @default(pending)
  externalId        String?
  amount            Decimal          @db.Decimal(12, 2)
  payload           Json?
  /** MP collector_id when splitMode=seller_oauth_v1 (seller token + fee). */
  collectorMpUserId String?
  /** Snapshot of application_fee sent to MP (sandbox Phase 2). */
  applicationFee    Decimal?         @db.Decimal(12, 2)
  splitMode         PaymentSplitMode @default(off)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  events            PaymentEvent[]

  @@index([orderId])
  @@index([externalId])
  @@index([collectorMpUserId])
}

model PaymentEvent {
  id              String   @id @default(uuid())
  provider        String
  providerEventId String
  paymentId       String?
  payment         Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  topic           String?
  payload         Json?
  applied         Boolean  @default(false)
  createdAt       DateTime @default(now())
  reconciliations PaymentReconciliation[]

  @@unique([provider, providerEventId])
  @@index([paymentId])
}

/** Durable follow-up when an authenticated webhook did not apply (orphan, or amount/reference mismatch). */
model PaymentReconciliation {
  id                String    @id @default(uuid())
  provider          String
  externalId        String
  externalReference String?
  providerStatus    String
  reason            String
  status            String    @default("RECONCILIATION_REQUIRED")
  paymentEventId    String?
  paymentEvent      PaymentEvent? @relation(fields: [paymentEventId], references: [id], onDelete: SetNull)
  meta              Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  resolvedAt        DateTime?

  @@unique([provider, externalId])
  @@index([status, createdAt])
  @@index([paymentEventId])
}

model Review {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  body      String   @default("")
  /** published | hidden */
  status    String   @default("published")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, userId])
  @@index([productId, status])
  @@index([status, createdAt])
}

/** Lista de desejos (Salvos) do cliente logado. Visitante não grava aqui. */
model Favorite {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([productId])
  @@index([userId, createdAt])
}


model CashbackLedger {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId      String?
  order        Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  /** earn | redeem | refund */
  kind         String
  amount       Decimal  @db.Decimal(12, 2)
  balanceAfter Decimal  @db.Decimal(12, 2)
  note         String?
  createdAt    DateTime @default(now())

  @@unique([orderId, kind])
  @@index([userId])
  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  action    String
  entity    String?
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([action])
  @@index([createdAt])
}

model IdempotencyRecord {
  id          String   @id @default(uuid())
  key         String   @unique
  userId      String?
  requestHash String
  response    Json?
  status      String   @default("pending")
  createdAt   DateTime @default(now())

  @@index([userId])
}

/** Frete própria (entrega do lojista) — configuração global. */
model ShippingSettings {
  id          String   @id @default("default")
  /** Frete grátis a partir deste subtotal (BRL). */
  freeAbove   Decimal  @db.Decimal(12, 2)
  /** Taxa padrão quando nenhuma zona de CEP casa. */
  defaultFee  Decimal  @db.Decimal(12, 2)
  /** Prazo padrão em dias úteis estimados. */
  defaultDays Int      @default(5)
  updatedAt   DateTime @updatedAt
}

/** Regra de frete por prefixo de CEP (1–8 dígitos). Prefixo mais longo vence. */
model ShippingCepRule {
  id            String   @id @default(uuid())
  /** Somente dígitos, ex.: "890" ou "89010". */
  cepPrefix     String
  fee           Decimal  @db.Decimal(12, 2)
  estimatedDays Int      @default(5)
  label         String?
  active        Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([cepPrefix])
  @@index([active])
}

/** SEO e identidade da loja (singleton). */
model StoreSettings {
  id              String   @id @default("default")
  siteTitle       String   @default("Lojas Schimitz")
  siteDescription String   @default("Tudo o que você precisa. No padrão das grandes. Eletro, celulares e casa em Porto Alegre.")
  ogImageUrl      String?
  updatedAt       DateTime @updatedAt
}

/** Banners da home (carrossel, no máximo 5 na vitrine). */
model HomeBanner {
  id        String   @id @default(uuid())
  title     String   @default("")
  alt       String   @default("")
  imageUrl  String
  linkUrl   String?
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, sortOrder])
}

/** Histórico de status do pedido (rastreamento com timestamps). */
model OrderStatusHistory {
  id         String   @id @default(uuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus String?
  toStatus   String
  actorId    String?
  note       String?
  createdAt  DateTime @default(now())

  @@index([orderId, createdAt])
}

/** Aparelho Android com token FCM (promo push). userId nulo = visitante. */
enum PushPlatform {
  android
}

enum PushCampaignAudience {
  all_enabled
  with_orders
}

enum PushCampaignStatus {
  draft
  scheduled
  sending
  sent
  failed
  cancelled
}

enum PushDispatchStatus {
  sent
  failed
  skipped
}

model DeviceFcmToken {
  id          String       @id @default(uuid())
  token       String       @unique
  userId      String?
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  platform    PushPlatform @default(android)
  enabled     Boolean      @default(true)
  lastSeenAt  DateTime     @default(now())
  appVersion  String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  dispatches          PushDispatch[]
  productViews        ProductViewEvent[]
  abandonedViewPushes AbandonedViewPush[]

  @@index([userId])
  @@index([enabled, platform])
  @@index([lastSeenAt])
}

/** Campanha promocional FCM (admin). Independente da tabela in-app Notification. */
model PushCampaign {
  id             String                @id @default(uuid())
  title          String
  body           String
  imageUrl       String?
  linkPath       String                @default("/")
  audience       PushCampaignAudience  @default(all_enabled)
  status         PushCampaignStatus    @default(draft)
  scheduledAt    DateTime?
  createdById    String?
  createdBy      User?                 @relation(fields: [createdById], references: [id], onDelete: SetNull)
  sentAt         DateTime?
  sentCount      Int                   @default(0)
  failedCount    Int                   @default(0)
  skippedCount   Int                   @default(0)
  errorSummary   String?
  firebaseReady  Boolean               @default(false)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  dispatches     PushDispatch[]

  @@index([status, scheduledAt])
  @@index([createdAt])
}

model PushDispatch {
  id             String              @id @default(uuid())
  campaignId     String
  campaign       PushCampaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  tokenId        String?
  token          DeviceFcmToken?     @relation(fields: [tokenId], references: [id], onDelete: SetNull)
  tokenFingerprint String
  status         PushDispatchStatus
  error          String?
  fcmMessageId   String?
  createdAt      DateTime            @default(now())

  @@index([campaignId, createdAt])
  @@index([tokenId])
}

/**
 * Última visita à PDP por aparelho FCM + produto.
 * lastViewedAt desliza a cada nova visita. handledViewAt = snapshot já decidido
 * (enviado, comprado, cap, indisponível ou velho demais).
 */
model ProductViewEvent {
  id            String         @id @default(uuid())
  deviceId      String
  device        DeviceFcmToken @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  productId     String
  product       Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId        String?
  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  lastViewedAt  DateTime
  handledViewAt DateTime?
  /** Cap diário / 7 dias: não reprocessar até este instante. Nova visita zera. */
  deferUntil    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([deviceId, productId])
  @@index([lastViewedAt])
  @@index([deferUntil, lastViewedAt])
  @@index([userId, productId])
}

/** Push de recuperação (viu o produto e não comprou). Só status=sent conta nos limites. */
model AbandonedViewPush {
  id               String             @id @default(uuid())
  deviceId         String
  device           DeviceFcmToken     @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  productId        String
  product          Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId           String?
  status           PushDispatchStatus
  error            String?
  fcmMessageId     String?
  tokenFingerprint String
  sentAt           DateTime           @default(now())

  @@index([deviceId, sentAt])
  @@index([deviceId, productId, sentAt])
}

/** Notificações in-app do cliente. */
model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String    @default("")
  linkUrl   String?
  orderId   String?
  order     Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

enum PaymentSplitMode {
  off
  seller_oauth_v1
  /** PIX sandbox: MP rejected application_fee; commission tracked in ledger only. */
  ledger_only
}

enum CommissionSource {
  manual_pix
  mp_application_fee
  /** Expected marketplace % when PIX could not send application_fee. */
  pending_manual_or_pix_no_fee
}

enum CommissionStatus {
  pending
  approved
  paid
  cancelled
}

/** Marketplace commission ledger — recorded on paid orders; payouts are manual PIX (Repasse v1). */
model CommissionLedger {
  id              String           @id @default(uuid())
  sellerId        String
  seller          Seller           @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  orderId         String
  order           Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItemId     String           @unique
  orderItem       OrderItem        @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  /** itemTotal * commissionPercent / 100 */
  amount          Decimal          @db.Decimal(12, 2)
  /** Snapshot of Seller.commissionPercent (or default) at record time. */
  percent         Decimal          @db.Decimal(5, 2)
  status          CommissionStatus @default(pending)
  /** PIX end-to-end id or manual transfer reference when status=paid. */
  payoutReference String?          @db.VarChar(120)
  /** Optional admin note when approving / marking paid. */
  payoutNote      String?          @db.VarChar(500)
  /** manual_pix = Repasse v1; mp_application_fee = sandbox fee withheld; pending_manual_or_pix_no_fee = PIX without MP fee. */
  source          CommissionSource @default(manual_pix)
  mpPaymentId     String?
  mpApplicationFee Decimal?        @db.Decimal(12, 2)
  approvedAt      DateTime?
  paidAt          DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([sellerId, status])
  @@index([orderId])
  @@index([status, createdAt])
}
